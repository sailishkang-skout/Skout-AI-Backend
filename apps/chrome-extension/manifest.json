{
  "manifest_version": 3,
  "name": "Skout AI Prospector",
  "version": "0.8.0",
  "description": "Capture LinkedIn profiles into Skout lists, enrich contacts, and send sequence connection requests/messages.",
  "permissions": ["storage", "activeTab", "scripting", "webNavigation", "sidePanel", "tabs", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*"
  ],
  "action": {
    "default_title": "Open Skout AI panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*",
      "https://*.execute-api.us-east-1.amazonaws.com/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"],
      "js": ["linkedin-scrape.js", "linkedin-search-scrape.js", "linkedin-bridge.js", "linkedin-outreach.js", "content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://*.execute-api.us-east-1.amazonaws.com/*"
      ],
      "js": ["skout-web-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
