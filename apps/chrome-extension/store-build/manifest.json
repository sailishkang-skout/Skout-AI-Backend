{
  "manifest_version": 3,
  "name": "Skout AI Prospector",
  "version": "0.9.0",
  "description": "Capture reviewed LinkedIn profiles, companies and Sales Navigator results into Skout, and enrich contacts.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://www.skoutai.io/*",
    "https://skoutai.io/*",
    "https://ckoy6iywm0.execute-api.us-east-1.amazonaws.com/*"
  ],
  "action": {
    "default_title": "Open Skout AI panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://www.skoutai.io/*",
      "https://skoutai.io/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": [
        "dist/linkedin-scrape.js",
        "linkedin-search-scrape.js",
        "dist/linkedin-bridge.js",
        "dist/content-script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "capture/extract-common.js",
        "capture/company-sections.js",
        "capture/page-extract.js",
        "capture/restriction-detect.js",
        "capture/capture-ui.js",
        "capture/company-capture.js",
        "capture/person-capture.js",
        "capture/sales-navigator-capture.js",
        "capture/sales-lead-link-reader.js",
        "capture/company-people-search.js",
        "capture/capture-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.skoutai.io/*",
        "https://skoutai.io/*"
      ],
      "js": [
        "dist/skout-web-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}