{
  "manifest_version": 3,
  "name": "Skout AI Prospector",
  "version": "0.8.2",
  "description": "Capture LinkedIn profiles into Skout lists, enrich contacts, and send sequence connection requests/messages.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://www.skoutai.io/*",
    "https://skoutai.io/*",
    "https://*.execute-api.us-east-1.amazonaws.com/*"
  ],
  "action": {
    "default_title": "Open Skout AI panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://www.skoutai.io/*",
      "https://skoutai.io/*",
      "https://*.execute-api.us-east-1.amazonaws.com/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": [
        "dist/linkedin-scrape.js",
        "linkedin-search-scrape.js",
        "dist/linkedin-bridge.js",
        "linkedin-outreach.js",
        "dist/content-script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.skoutai.io/*",
        "https://skoutai.io/*",
        "https://*.execute-api.us-east-1.amazonaws.com/*"
      ],
      "js": [
        "dist/skout-web-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}