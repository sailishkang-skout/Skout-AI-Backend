        {
          "name": "GET /pipelines (auto-seeds default on first call)",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-stub-user-email", "value": "{{stubEmail}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/pipelines", "host": ["{{baseUrl}}"], "path": ["api", "v1", "pipelines"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('exactly one default pipeline', () => { pm.expect(body.total).to.eql(1); pm.expect(body.data[0].isDefault).to.be.true; });",
                  "pm.test('has 6 stages', () => pm.expect(body.data[0].stages).to.have.lengthOf(6));",
                  "const pipeline = body.data[0];",
                  "pm.collectionVariables.set('pipelineId', pipeline.id);",
                  "const sorted = [...pipeline.stages].sort((a, b) => a.orderIndex - b.orderIndex);",
                  "pm.collectionVariables.set('firstStageId', sorted[0].id);",
                  "pm.collectionVariables.set('secondStageId', sorted[1].id);"
                ],
                "type": "text/javascript"
              }
            }
