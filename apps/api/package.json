{
  "name": "@skout/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @skout/db build && pnpm --filter @skout/shared build && pnpm --filter @skout/auth build && pnpm --filter @skout/storage build && pnpm --filter @skout/scraper-orchestrator build && pnpm --filter @skout/crm-bridge build",
    "dev": "tsx watch --ignore '**/node_modules/**' --ignore '**/dist/**' src/index.ts",
    "worker:crm-export": "tsx src/workers/crm-export.worker.ts",
    "worker:sequence": "tsx src/workers/sequence-enrollment.worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"lint: configure eslint\"",
    "pretest": "pnpm --filter @skout/db build && pnpm --filter @skout/shared build && pnpm --filter @skout/auth build && pnpm --filter @skout/scraper-orchestrator build && node scripts/ensure-test-postgres.mjs && pnpm --filter @skout/crm-bridge build",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.758.0",
    "@aws-sdk/client-sesv2": "^3.1087.0",
    "@clerk/backend": "^3.6.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@opentelemetry/api": "^1.9.1",
    "@skout/auth": "workspace:*",
    "@skout/crm-bridge": "workspace:*",
    "@skout/db": "workspace:*",
    "@skout/observability": "workspace:*",
    "@skout/opensearch": "workspace:*",
    "@skout/pal": "workspace:*",
    "@skout/scraper-contracts": "workspace:*",
    "@skout/scraper-orchestrator": "workspace:*",
    "@skout/shared": "workspace:*",
    "@skout/storage": "workspace:*",
    "bullmq": "^5.40.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "imapflow": "^1.4.3",
    "ioredis": "^5.4.1",
    "mailparser": "^3.9.12",
    "nodemailer": "^9.0.3",
    "openai": "^6.45.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}