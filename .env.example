# Skout AI Backend — copy to .env for local development
#   cp .env.example .env

# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL (docker-compose maps host 5434 → container 5432; avoids macOS Postgres on 5432)
DATABASE_URL=postgresql://skout:skout@localhost:5434/skout

# Alternative: individual DB vars (used by ECS / CDK deploy)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=skout
# DATABASE_USER=skout
# DATABASE_PASSWORD=skout

# Redis
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:3000

# External services
# OpenSearch (docker compose includes opensearch on :9200; seed with `pnpm opensearch:seed`)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=prospects
# Demo corpus size for pnpm opensearch:seed and in-memory search fallback
DEMO_CORPUS_SIZE=5300
SEARCH_CREDIT_COST=1
SEARCH_CACHE_TTL_SECONDS=300
CLICKHOUSE_URL=http://skout:skout@localhost:8123/skout
AI_SERVICE_URL=http://localhost:8000
# Run the Skout-Email-Intelligence-Tool repo's own docker-compose.yml locally for this.
# Email Intelligence (Discover / Verify / Patterns)
# Prefer the internal ECS service when available; Hunter is used as fallback for discover/verify.
EMAIL_INTEL_SERVICE_URL=http://localhost:3001
EMAIL_INTEL_TIMEOUT_MS=15000
EMAIL_INTEL_DISCOVER_TIMEOUT_MS=60000

# Tier 1 corpus pipeline + list CSV exports (scrapers → S3, exports → S3)
# Local MinIO (docker compose): console http://localhost:9001  user/pass minioadmin
SCRAPE_BUCKET=skout-scrape-dev
EXPORTS_BUCKET=skout-exports-dev
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# AWS prod/dev: set SCRAPE_BUCKET + EXPORTS_BUCKET from CDK outputs; omit S3_ENDPOINT
# SCRAPE_LOCAL_DIR=   # only used when SCRAPE_BUCKET is unset (filesystem fallback)
# OPENCORPORATES_API_KEY=
# OPENCORPORATES_BASE_URL=https://api.opencorporates.com/v0.4
# SEC_EDGAR_BASE_URL=https://efts.sec.gov/LATEST/search-index
# LINKEDIN_ACCOUNTS_JSON=[{"username":"...","password":"..."}]

# Auth (Clerk)
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# AUTH_STUB=true   # optional local only — skip JWT (default: false when CLERK_SECRET_KEY is set)

# Static-auth admin data-import page (frontend /admin/import). Leave both unset to disable —
# the auth path in plugins/auth.ts rejects `admin_*` tokens if either is missing. The secret
# should be a long random string (32+ chars); it is scoped to /api/v1/import/* routes only.
# ADMIN_IMPORT_SECRET=
# ADMIN_IMPORT_WORKSPACE_ID=

# R20.2 — Twilio click-to-call. Unset = the "Call" button stays disabled workspace-wide.
# TWILIO_ENABLED=false       # set true to use Twilio when creds exist; otherwise Telnyx is used
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WEBHOOK_BASE_URL=   # publicly reachable API base URL; defaults to API_PUBLIC_URL
# TELNYX_API_KEY=
# TELNYX_PHONE_NUMBER=
# TELNYX_CONNECTION_ID=      # TeXML application / connection ID
# TELECOM_WEBHOOK_BASE_URL=  # optional alias for TWILIO_WEBHOOK_BASE_URL

# R16.2 — meeting-bot vendor (Recall.ai is the only one wired up; see docs/tickets). Unset =
# "Schedule bot" stays disabled on meetings.
# MEETING_BOT_PROVIDER=recall
# MEETING_BOT_API_KEY=
# MEETING_BOT_WEBHOOK_SECRET=   # shared secret checked on the inbound webhook's ?secret= param
# CRM_PUBLIC_URL=   # apps/crm's own publicly reachable base URL, for the meeting-bot webhook callback
# R16.3 — transcript field extraction runs inside apps/crm (a separately deployed service from
# apps/api), so if you run them with separate env files, apps/crm also needs its own
# OPENROUTER_API_KEY (+ optional AI_MODEL, see below) or extraction is silently skipped and only
# vendor-supplied extractedFields (if any) are used.

# R22.1 — Apollo.io import is workspace-scoped BYOK (Settings -> Integrations), not an env var.

# AI / enrichment providers
# INTEGRATION_ENCRYPTION_KEY=    # AES-256 key for workspace BYOK API keys (prod: random 32+ chars)
# OPENAI_API_KEY=
# OpenRouter (LLM for scoring, email generation, AI review drafts)
# OPENROUTER_API_KEY=
# OPEN_ROUTER_API_KEY=           # alias accepted — same as OPENROUTER_API_KEY
# AI_MODEL=openai/gpt-4o-mini
# APOLLO_API_KEY=
#
# PAL enrichment providers — leave blank to use deterministic stub adapters.
# Any capability whose key is set switches to the live provider automatically.
# HUNTER_API_KEY=                # email finder + verifier    (https://hunter.io)
# MILLIONVERIFIER_API_KEY=       # bulk email verify          (https://millionverifier.com)
# ZEROBOUNCE_API_KEY=            # email verify accuracy gate (https://zerobounce.net)
# NEVERBOUNCE_API_KEY=           # email verify accuracy gate (https://neverbounce.com)
# PDL_API_KEY=                   # company firmographics      (https://peopledatalabs.com)
# REVENUEBASE_API_KEY=           # firmographics fallback     (https://revenuebase.ai)
# EXPLORIUM_API_KEY=             # firmographics fallback     (https://explorium.ai)
# CORESIGNAL_API_KEY=            # firmographics fallback     (https://coresignal.com)
# DATAGMA_API_KEY=               # phone (score-gated)        (https://datagma.com)
# CONTACTOUT_API_KEY=            # phone fallback             (https://contactout.com)
# COGNISM_API_KEY=               # phone EMEA fallback        (https://cognism.com)

# Provider base URLs — defaults shown; override for sandboxes / regional endpoints.
# HUNTER_BASE_URL=https://api.hunter.io/v2
# MILLIONVERIFIER_BASE_URL=https://api.millionverifier.com/api/v3
# ZEROBOUNCE_BASE_URL=https://api.zerobounce.net/v2
# NEVERBOUNCE_BASE_URL=https://api.neverbounce.com/v4
# PDL_BASE_URL=https://api.peopledatalabs.com/v5
# REVENUEBASE_BASE_URL=https://api.revenuebase.ai
# EXPLORIUM_BASE_URL=https://api.explorium.ai/v1
# CORESIGNAL_BASE_URL=https://api.coresignal.com/cdapi/v2
# DATAGMA_BASE_URL=https://gateway.datagma.net/api/ingress
# CONTACTOUT_BASE_URL=https://api.contactout.com
# COGNISM_BASE_URL=https://app.cognism.com/api

# Enrichment tunables (defaults shown)
# ENRICHMENT_REQUEST_TIMEOUT_MS=8000
# ENRICHMENT_PHONE_SCORE_GATE=80
# ENRICHMENT_AI_TIMEOUT_MS=5000

# HubSpot CRM
# HUBSPOT_CLIENT_ID=              # HubSpot Developer → Projects → skout-crm → Auth
# HUBSPOT_CLIENT_SECRET=

# Razorpay billing — checkout activates only when BOTH KEY_ID and KEY_SECRET are set.
# KEY_ID is the public/publishable id (safe in client); KEY_SECRET must stay server-side.
RAZORPAY_KEY_ID=rzp_test_T6GFakUYJvBoOr
# RAZORPAY_KEY_SECRET=        # required for order creation — get the test secret from Razorpay dashboard
# RAZORPAY_WEBHOOK_SECRET=    # optional — verifies the payment.captured webhook
RAZORPAY_CREDIT_PACKS_JSON=[{"id":"starter","label":"Starter","credits":500,"amountInr":499},{"id":"growth","label":"Growth","credits":2000,"amountInr":1499},{"id":"scale","label":"Scale","credits":10000,"amountInr":4999}]
# CRM_SECRETS_PREFIX=SkoutDev/crm  # Per-workspace OAuth tokens in AWS Secrets Manager (prod)
# CRM_CREDENTIALS_LOCAL=true        # Local dev: store tokens in .crm-secrets/ instead of AWS
# API_PUBLIC_URL=http://localhost:3001   # OAuth callback base (local)

# --- Observability & security ---
# See README.md § "Observability" for where to get each value and how to test locally.
SERVICE_NAME=skout-api
SERVICE_VERSION=0.1.0-local
LOG_LEVEL=info                       # debug | info | warn | error
SENTRY_DSN=                          # https://sentry.io → Project → Settings → Client Keys (DSN)
SENTRY_TRACES_SAMPLE_RATE=0.1
POSTHOG_API_KEY=                     # https://posthog.com → Project Settings → Project API key (phc_...)
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=                  # PostHog → Project Settings → Project ID
DD_API_KEY=                          # https://us5.datadoghq.com → Organization Settings → API Keys
DD_SITE=us5.datadoghq.com            # Your Datadog site (US5 cloud)
TRUST_PROXY=false                    # true on AWS behind ALB; false for local direct access
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
REQUEST_BODY_LIMIT_BYTES=1048576
INTEGRATION_ENCRYPTION_KEY=            # openssl rand -base64 32  (BYOK key encryption)

# Transactional system emails (team invites, invite OTP) — apps/api mail.service.ts
# Prefer AWS SES SMTP in deployed envs (Secrets Manager: <stackPrefix>/smtp).
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USERNAME=                 # SES SMTP username (IAM access key id)
# SMTP_PASSWORD=                 # SES SMTP password (derived from secret access key)
# SES_FROM_EMAIL=noreply@skoutai.io   # must be a verified SES identity
# INVITE_BASE_URL=https://your-app-domain.com   # base URL for /invite/:token links
#
# Local Gmail alternative (App Password, not login password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-gmail@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SES_FROM_EMAIL=your-gmail@gmail.com

# LinkedIn + WhatsApp sequence outreach via Unipile (server-side — no Chrome extension required)
# UNIPILE_DSN=https://api1.unipile.com:13111
# UNIPILE_API_KEY=
