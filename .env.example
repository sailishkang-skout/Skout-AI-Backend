# Skout AI Backend — copy to .env for local development
#   cp .env.example .env

# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL (docker-compose maps host 5434 → container 5432; avoids macOS Postgres on 5432)
DATABASE_URL=postgresql://skout:skout@localhost:5434/skout

# Alternative: individual DB vars (used by ECS / CDK deploy)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=skout
# DATABASE_USER=skout
# DATABASE_PASSWORD=skout

# Redis
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:3000

# External services
# OpenSearch (docker compose includes opensearch on :9200; seed with `pnpm opensearch:seed`)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=prospects
CLICKHOUSE_URL=http://localhost:8123
AI_SERVICE_URL=http://localhost:8000

# Tier 1 corpus pipeline (scrapers → S3 → OpenSearch)
# SCRAPE_BUCKET=skout-scrape-dev
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# OPENCORPORATES_API_KEY=
# OPENCORPORATES_BASE_URL=https://api.opencorporates.com/v0.4
# SEC_EDGAR_BASE_URL=https://efts.sec.gov/LATEST/search-index
# LINKEDIN_ACCOUNTS_JSON=[{"username":"...","password":"..."}]

# S3 exports bucket (AWS only)
# EXPORTS_BUCKET=

# Auth (Clerk)
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# AUTH_STUB=true   # optional local only — skip JWT (default: false when CLERK_SECRET_KEY is set)

# AI / enrichment providers
# OPENAI_API_KEY=
# APOLLO_API_KEY=
#
# PAL enrichment providers — leave blank to use deterministic stub adapters.
# Any capability whose key is set switches to the live provider automatically.
# HUNTER_API_KEY=                # email finder + verifier    (https://hunter.io)
# MILLIONVERIFIER_API_KEY=       # bulk email verify          (https://millionverifier.com)
# ZEROBOUNCE_API_KEY=            # email verify accuracy gate (https://zerobounce.net)
# NEVERBOUNCE_API_KEY=           # email verify accuracy gate (https://neverbounce.com)
# PDL_API_KEY=                   # company firmographics      (https://peopledatalabs.com)
# REVENUEBASE_API_KEY=           # firmographics fallback     (https://revenuebase.ai)
# EXPLORIUM_API_KEY=             # firmographics fallback     (https://explorium.ai)
# CORESIGNAL_API_KEY=            # firmographics fallback     (https://coresignal.com)
# DATAGMA_API_KEY=               # phone (score-gated)        (https://datagma.com)
# CONTACTOUT_API_KEY=            # phone fallback             (https://contactout.com)
# COGNISM_API_KEY=               # phone EMEA fallback        (https://cognism.com)

# Provider base URLs — defaults shown; override for sandboxes / regional endpoints.
# HUNTER_BASE_URL=https://api.hunter.io/v2
# MILLIONVERIFIER_BASE_URL=https://api.millionverifier.com/api/v3
# ZEROBOUNCE_BASE_URL=https://api.zerobounce.net/v2
# NEVERBOUNCE_BASE_URL=https://api.neverbounce.com/v4
# PDL_BASE_URL=https://api.peopledatalabs.com/v5
# REVENUEBASE_BASE_URL=https://api.revenuebase.ai
# EXPLORIUM_BASE_URL=https://api.explorium.ai/v1
# CORESIGNAL_BASE_URL=https://api.coresignal.com/cdapi/v2
# DATAGMA_BASE_URL=https://gateway.datagma.net/api/ingress
# CONTACTOUT_BASE_URL=https://api.contactout.com
# COGNISM_BASE_URL=https://app.cognism.com/api

# Enrichment tunables (defaults shown)
# ENRICHMENT_REQUEST_TIMEOUT_MS=8000
# ENRICHMENT_PHONE_SCORE_GATE=80
# ENRICHMENT_AI_TIMEOUT_MS=5000

# HubSpot CRM
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# Public API URL for OAuth callbacks (dev: http://SkoutDev-alb-....amazonaws.com)
# API_PUBLIC_URL=
