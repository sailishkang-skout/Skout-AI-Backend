# Skout AI Backend — UAT / sandbox template (coming soon)
# Branch: uat → AWS UAT deployment
# Copy when UAT stack is provisioned: cp .env.uat.example .env.uat

NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

CORS_ORIGIN=http://REPLACE_WITH_UAT_ALB_DNS

DATABASE_HOST=REPLACE_WITH_UAT_RDS_ENDPOINT
DATABASE_PORT=5432
DATABASE_NAME=skout
DATABASE_USER=skout
DATABASE_PASSWORD=REPLACE_FROM_SECRETS_MANAGER

REDIS_URL=redis://REPLACE_WITH_UAT_REDIS_ENDPOINT:6379
AI_SERVICE_URL=http://ai.skoutuat.local:8000
EXPORTS_BUCKET=REPLACE_WITH_UAT_EXPORTS_BUCKET

# OPENAI_API_KEY=          → AWS Secrets Manager: SkoutUat/openai
