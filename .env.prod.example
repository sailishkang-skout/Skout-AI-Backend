# Skout AI Backend — PRODUCTION template (coming soon)
# Branch: main → AWS production deployment
# Copy when prod stack is provisioned: cp .env.prod.example .env.prod

NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=warn

CORS_ORIGIN=https://REPLACE_WITH_PROD_APP_DOMAIN

DATABASE_HOST=REPLACE_WITH_PROD_RDS_ENDPOINT
DATABASE_PORT=5432
DATABASE_NAME=skout
DATABASE_USER=skout
DATABASE_PASSWORD=REPLACE_FROM_SECRETS_MANAGER

REDIS_URL=redis://REPLACE_WITH_PROD_REDIS_ENDPOINT:6379
AI_SERVICE_URL=http://ai.skoutprod.local:8000
EXPORTS_BUCKET=REPLACE_WITH_PROD_EXPORTS_BUCKET

# OPENAI_API_KEY=          → AWS Secrets Manager: SkoutProd/openai
