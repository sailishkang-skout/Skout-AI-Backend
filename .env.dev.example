# Skout AI Backend — DEV environment template
# Copy: cp .env.dev.example .env.dev
# Branch: develop → AWS dev deployment

NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

CORS_ORIGIN=http://REPLACE_WITH_DEV_ALB_DNS

DATABASE_HOST=REPLACE_WITH_DEV_RDS_ENDPOINT
DATABASE_PORT=5432
DATABASE_NAME=skout
DATABASE_USER=skout
DATABASE_PASSWORD=REPLACE_FROM_SECRETS_MANAGER

REDIS_URL=redis://REPLACE_WITH_DEV_REDIS_ENDPOINT:6379
AI_SERVICE_URL=http://ai.skoutdev.local:8000
EXPORTS_BUCKET=REPLACE_WITH_DEV_EXPORTS_BUCKET

# OPENAI_API_KEY=          → AWS Secrets Manager: SkoutDev/openai
# CLERK_SECRET_KEY=
# APOLLO_API_KEY=
# HUNTER_API_KEY=
