# Skout AI Backend — DEV environment template
# Copy: cp .env.dev.example .env.dev
# Branch: develop → AWS dev deployment

NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

CORS_ORIGIN=http://REPLACE_WITH_DEV_ALB_DNS

DATABASE_HOST=REPLACE_WITH_DEV_RDS_ENDPOINT
DATABASE_PORT=5432
DATABASE_NAME=skout
DATABASE_USER=skout
DATABASE_PASSWORD=REPLACE_FROM_SECRETS_MANAGER

REDIS_URL=redis://REPLACE_WITH_DEV_REDIS_ENDPOINT:6379
CLICKHOUSE_URL=http://skout:skout@clickhouse.skoutdev.local:8123/skout
AI_SERVICE_URL=http://ai.skoutdev.local:8000
EMAIL_INTEL_SERVICE_URL=http://email-intel.skoutdev.local:3001
EXPORTS_BUCKET=REPLACE_WITH_DEV_EXPORTS_BUCKET
SCRAPE_BUCKET=REPLACE_WITH_DEV_SCRAPE_BUCKET
# S3_ENDPOINT unset on AWS — task role provides credentials

# Fail-closed RBAC (SkoutDev) — enable only after backfill-rbac on that DB
RBAC_ENFORCEMENT_ENABLED=true

# OPENAI_API_KEY=          → AWS Secrets Manager: SkoutDev/openai
# CLERK_SECRET_KEY=
# APOLLO_API_KEY=
# HUNTER_API_KEY=

# Razorpay billing (checkout needs BOTH id + secret)
RAZORPAY_KEY_ID=rzp_test_T6GFakUYJvBoOr
# RAZORPAY_KEY_SECRET=        → AWS Secrets Manager: SkoutDev/razorpay (test secret)
# RAZORPAY_WEBHOOK_SECRET=    → AWS Secrets Manager: SkoutDev/razorpay (webhook)
RAZORPAY_CREDIT_PACKS_JSON=[{"id":"starter","label":"Starter","credits":500,"amountInr":499},{"id":"growth","label":"Growth","credits":2000,"amountInr":1499},{"id":"scale","label":"Scale","credits":10000,"amountInr":4999}]
