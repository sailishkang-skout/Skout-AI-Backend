{
  "name": "skout-ai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Skout AI backend monorepo — Core API, workers, shared packages",
  "scripts": {
    "dev": "pnpm --filter @skout/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @skout/db generate",
    "db:migrate": "pnpm --filter @skout/db migrate",
    "db:seed": "pnpm --filter @skout/db seed",
    "db:push": "pnpm --filter @skout/db push",
    "db:studio": "pnpm --filter @skout/db studio",
    "prepare": "husky",
    "docker:local": "docker compose -f docker-compose.yml -f docker-compose.local.yml up --build",
    "infra:synth": "pnpm --filter @skout/infra synth",
    "infra:synth:local": "pnpm --filter @skout/infra synth:local",
    "infra:synth:dev": "pnpm --filter @skout/infra synth:dev",
    "infra:synth:prod": "pnpm --filter @skout/infra synth:prod",
    "infra:local-env": "pnpm --filter @skout/infra local:env",
    "infra:deploy:dev": "pnpm --filter @skout/infra deploy:dev",
    "infra:deploy:uat": "pnpm --filter @skout/infra deploy:uat",
    "infra:deploy:prod": "pnpm --filter @skout/infra deploy:prod",
    "infra:synth:uat": "pnpm --filter @skout/infra synth:uat"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
