{
	auto_https off
	admin off
}

(proxy) {
	header_up X-Forwarded-For {header.Cf-Connecting-Ip}
	header_up X-Forwarded-Proto https
	header_up x-skout-public-origin https://{host}
}

:80 {
	@crm path /api/v1/crm/health /api/v1/companies* /api/v1/contacts* /api/v1/deals* /api/v1/pipelines* /api/v1/tasks* /api/v1/activities* /api/v1/meetings* /api/v1/dashboard/overview* /api/v1/dashboard/switching-cost* /api/v1/dashboard/cro-summary* /api/v1/dashboard/pipeline-velocity* /api/v1/audit-logs* /api/v1/promotion-candidates* /api/v1/dashboard/stale-deals* /api/v1/dashboard/missing-stakeholder* /api/v1/dashboard/disengagement-flags* /api/v1/dashboard/renewal-risk-flags* /api/v1/dashboard/expansion-signal-flags* /api/v1/retention-rules* /api/v1/buying-committee*
	handle @crm {
		reverse_proxy crm:3002 {
			import proxy
		}
	}

	handle /api/* {
		reverse_proxy api:3001 {
			import proxy
		}
	}

	handle /.well-known/jwks.json {
		reverse_proxy api:3001 {
			import proxy
		}
	}

	handle {
		reverse_proxy web:3000 {
			import proxy
		}
	}
}
