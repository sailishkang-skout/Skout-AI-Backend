                    "label": "warning > 500",
                    "value": "y = 500",
                    "display_type": "warning dashed"
                  },
                  {
                    "label": "critical > 5000",
                    "value": "y = 5000",
                    "display_type": "error dashed"
                  }
                ]
              },
              "layout": {
                "x": 4,
                "y": 0,
                "width": 4,
                "height": 2
              }
            },
            {
              "definition": {
