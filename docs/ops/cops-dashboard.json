                  },
                  {
                    "label": "critical > 10",
                    "value": "y = 10",
                    "display_type": "error dashed"
                  }
                ]
              },
              "layout": {
                "x": 8,
                "y": 0,
                "width": 4,
                "height": 2
              }
            }
          ]
        }
      },
      {
