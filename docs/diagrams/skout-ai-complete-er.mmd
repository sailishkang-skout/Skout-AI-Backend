        uuid id PK
        uuid workspace_id FK
        string provider
        string status
        string external_account_id
        string settings
        string credentials_ref
        datetime token_expires_at
        datetime connected_at
        datetime updated_at
    }

    webhook_endpoints {
        uuid id PK
        uuid workspace_id FK
        string url
        string secret_hash
        string events
        string status
        datetime created_at
        datetime updated_at
    }

    webhook_deliveries {
        uuid id PK
        uuid endpoint_id FK
        string event_type
        string payload
        string status
        int attempts
        int response_status
        datetime last_attempt_at
        datetime created_at
    }

