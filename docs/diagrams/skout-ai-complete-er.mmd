erDiagram
    opensearch_prospects_index {
        string prospect_id PK
        string company_id
        string fullName
        string title
        string seniority
        string country
        string industry
        string companyDomain
        int employeeCount
        string keywords
    }

    workspaces {
        uuid id PK
        string name
        string slug UK
        datetime created_at
        datetime updated_at
    }

    users {
        uuid id PK
        string email UK
        string full_name
        datetime created_at
        datetime updated_at
    }

    workspace_members {
        uuid workspace_id PK
        uuid user_id PK
        string role
        datetime joined_at
    }

    credit_balances {
        uuid workspace_id PK
        int balance
        datetime updated_at
    }

    credit_transactions {
        uuid id PK
        uuid workspace_id FK
        int amount
        string action
        string reference_id
        datetime created_at
    }

    workspace_icp {
        uuid workspace_id PK
        string config
        int version
        datetime updated_at
    }

    prospect_activations {
        uuid id PK
        uuid workspace_id FK
        string prospect_id
        string company_id
        string snapshot
        int record_version
        datetime activated_at
        datetime updated_at
    }

    lists {
        uuid id PK
        uuid workspace_id FK
        string name
        datetime created_at
        datetime updated_at
    }

