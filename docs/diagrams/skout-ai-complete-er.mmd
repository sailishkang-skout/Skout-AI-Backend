        uuid id PK
        uuid workspace_id FK
        uuid activation_id FK
        uuid async_job_id FK
        string prospect_id
        string status
        string trigger
        string fields_requested
        string error_message
        datetime queued_at
        datetime started_at
        datetime completed_at
