        uuid id PK
        uuid workspace_id FK
        uuid inbox_id FK
        string prospect_id
        string subject
        string status
        datetime last_message_at
        datetime created_at
        datetime updated_at
    }

    inbox_messages {
        uuid id PK
        uuid thread_id FK
        string direction
        string from_address
        string to_address
        string subject
        string body_text
        string body_html
        string external_id
        datetime sent_at
    }

    ai_drafts {
        uuid id PK
        uuid workspace_id FK
        string prospect_id
        uuid thread_id FK
        uuid enrollment_step_id FK
        string subject
        string body
        string status
        string model
        float confidence_score
        datetime created_at
        datetime reviewed_at
        uuid reviewed_by FK
    }

