        uuid id PK
        uuid enrichment_job_id FK
        int attempt_order
        string provider
        string operation
        string status
        string request_input
        string response_output
        int latency_ms
        datetime attempted_at
        datetime completed_at
    }

    enrichment_results {
        uuid id PK
        uuid enrichment_job_id FK
        uuid workspace_id FK
        string prospect_id
        string field_name
        string field_value
        string field_value_json
        string source_provider
        float confidence
        string validation_status
        bool is_primary
        datetime created_at
    }

    async_jobs {
        uuid id PK
        uuid workspace_id FK
        string job_type
        string status
        string entity_type
        string entity_id
        string payload
        string result
        string error_message
        string bullmq_job_id
        datetime queued_at
        datetime started_at
        datetime completed_at
    }

    sequences {
        uuid id PK
        uuid workspace_id FK
        string name
        string status
        datetime created_at
        datetime updated_at
    }

    sequence_steps {
        uuid id PK
        uuid sequence_id FK
        int step_order
        string step_type
        int delay_days
        string subject
        string body_template
        datetime created_at
    }

    sequence_enrollments {
        uuid id PK
        uuid workspace_id FK
        uuid sequence_id FK
        string prospect_id
        uuid list_id FK
        string status
        datetime enrolled_at
        datetime completed_at
    }

    sequence_enrollment_steps {
        uuid id PK
        uuid enrollment_id FK
        uuid step_id FK
        string status
        datetime scheduled_at
        datetime executed_at
    }

